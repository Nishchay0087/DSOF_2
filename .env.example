# Optional: copy to .env. No secrets are included.
DSOF_HOST=127.0.0.1
DSOF_PORT=5000
DSOF_CAPTURE=true
# Comma-separated exact Scapy interface IDs; list using python -m dsof check
# Defaults: Windows \Device\NPF_Loopback, macOS lo0, Linux lo
# DSOF_INTERFACES=lo0
DSOF_HONEYPOT_BIND=127.0.0.1
DSOF_WEB_PORT=8081
DSOF_SSH_PORT=2222
DSOF_DATABASE_PORT=3307
DSOF_ALLOW_REMOTE=false
DSOF_ML_THRESHOLD=0.90
DSOF_FLOW_IDLE_SECONDS=2
DSOF_FLOW_MAX_SECONDS=120
DSOF_MAX_FLOWS=2048
DSOF_MAX_PACKETS_PER_FLOW=100000
DSOF_QUEUE_SIZE=8192
DSOF_RETENTION_DAYS=7
# Raw feature parity with the unknown training pipeline remains unverified.

# macOS: fifo uses the privileged tcpdump helper with an unprivileged backend.
DSOF_CAPTURE_MODE=fifo
# Explicit authorized protected-service ports for the D component. Empty means unknown D.
DSOF_PROTECTED_PORTS=9090
